[Unit]
Description=EventSnap Infisical Webhook Agent
After=network.target

[Service]
User=github-actions
Group=github-actions
WorkingDirectory=/webhook

# Ensure systemd can find the 'uv' command
Environment="PATH=/home/github-actions/.cargo/bin:/home/github-actions/.local/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/usr/bin/env uv run main.py

# Automatically restart if it crashes
Restart=always
RestartSec=5

# Ensure output is sent to journalctl without delay
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
